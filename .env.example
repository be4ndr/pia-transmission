# Copy to .env and configure for your Docker host.
# Documentation-only values: replace with your Docker host address and LAN subnet.
# WEB_BIND_IP sets the host interface address where Compose publishes the WebUI/RPC port.
WEB_BIND_IP=192.0.2.10
# Transmission separately checks the HTTP Host header against this comma-separated list.
# Include the address and every DNS name clients will use. Unset means WEB_BIND_IP.
# Example: RPC_HOST_WHITELIST=192.0.2.10,transmission.example,transmission.lan.example
WEB_HOST_PORT=8088
# Packaged UI: transmission-web (default), transmission-web-legacy, transmission-default.
TRANSMISSION_WEB_UI=transmission-web
LOCAL_NETWORK=192.0.2.0/24

# Confirm with: id -u <user>; id -g <user>
PUID=1000
PGID=1000
TZ=UTC

# Must match a real PIA region ID; choose only after provider discovery.
# Placeholder: replace with a region ID from the provider inventory.
PIA_REGION=replace-with-region-id
# Requires a PF-capable region; unsupported regions keep VPN/RPC running.
PIA_PORT_FORWARDING=true
VPN_START_TIMEOUT=90
VPN_RETRY_DELAY=5

# Persistent settings and runtime state on host.
CONFIG_DIR=./state/config
DATA_DIR=./state/data

# Secrets live on the host outside this repository, not in .env.
# Placeholder: replace with your external credential directory.
PIA_SECRETS_DIR=/path/to/pia-credentials
